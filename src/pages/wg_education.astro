---
import BaseLayout from '../layouts/BaseLayout.astro';
const frontmatter = {
  title: 'MONAI - Education Working Group',
  description: 'The Education Working Group has merged into the MONAI Outreach, Adoption, and Education Working Group.',
  canonical: 'https://project-monai.github.io/wg_outreach_adoption_education.html',
  metaRefresh: '0; url=wg_outreach_adoption_education.html',
};
---
<BaseLayout {...frontmatter}>
        <!-- Redirect page (light) -->
        <section class="relative overflow-hidden bg-gradient-to-br from-white via-brand-light/40 to-white min-h-[calc(100vh-4rem)]">
            <div class="container relative z-10">
                <div class="min-h-[calc(100vh-4rem)] flex flex-col items-center justify-center text-center py-24">
                    <!-- Title -->
                    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight mb-8">
                        <span class="text-brand-accent">Education</span>
                        <br>
                        <span class="text-gray-900">Working Group</span>
                    </h1>

                    <!-- Message -->
                    <p class="text-lg md:text-xl text-gray-600 max-w-xl leading-relaxed mb-12">
                        This group has merged with the Outreach and Adoption Working Group. We are redirecting you to the Outreach, Adoption, and Education Working Group page. If you are not redirected automatically, use the link below.
                    </p>

                    <!-- CTA -->
                    <a class="px-7 py-3 rounded-lg bg-brand-primary text-gray-900 font-semibold hover:bg-brand-accent transition-all duration-200 flex items-center gap-2 group shadow-lg shadow-brand-primary/20" href="wg_outreach_adoption_education.html" data-track="cta_click" data-track-cta-id="wg_education_go_merged" data-track-cta-dest="wg_outreach_adoption_education.html">
                        Go to the Working Group
                        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
</BaseLayout>
